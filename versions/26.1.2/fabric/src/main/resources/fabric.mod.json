  "accessWidener" : "playercollars.accesswidener",
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": ">=26.1.2",
    "java": ">=25",
    "fabric-api": "*",
    "trinkets_updated": "*"
  }
