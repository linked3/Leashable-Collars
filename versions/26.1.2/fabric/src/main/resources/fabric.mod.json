  "authors": [
    "Dipilodopilasaurus"
  ],
  "contributors": [
    "jlortiz0 (original author)",
    "minecraftplayz01 (Leashable Collars Fabric Port)",
    "ElsaCounteragent (Fabric 1.21.4 fork)",
    "Filmorae (Fabric 26.1.2 fork)",
    "pog5",
    "tess-a-ract",
    "ItsCynthiaTime",
    "StarrySkiesVT",
    "H1ggsK",
    "erinsc"
  ],
  "contact": {
    "sources": "https://github.com/dipilo/Leashable-Collars",
    "homepage": "https://modrinth.com/mod/leashable-collars",
    "issues": "https://github.com/dipilo/Leashable-Collars/issues"
  },
